{
  "output_dir": "output",
  "site": {
    "start_url": "https://example.invalid/documents",
    "item_selector": ".document-row",
    "item_key_attribute": "data-id",
    "item_link_selector": "a.details",
    "next_page_selector": "a.next",
    "download_selector": "a.pdf-download"
  },
  "browser": {
    "headless": true,
    "page_timeout_seconds": 30
  },
  "allowed_download_hosts": ["example.invalid"],
  "request_delay_seconds": 1,
  "request_timeout_seconds": 60,
  "max_download_bytes": 104857600,
  "max_retries": 3
}
